# --- Server ---
PORT=4000
# Danh sách origin được phép gọi thẳng BE (phân tách dấu phẩy). Để trống = không bật CORS (FE gọi qua rewrite/proxy).
CORS_ORIGINS=
# URL gốc công khai của BE (dựng callback OAuth Zalo). Trống = suy từ header request.
APP_BASE_URL=

# --- Database (Supabase) ---
# DATABASE_URL: pooler 6543 (runtime). DIRECT_URL: kết nối trực tiếp 5432 (prisma migrate/db push).
DATABASE_URL=
DIRECT_URL=

# --- Worker gửi nền ---
SEND_WORKER_DISABLED=false
SEND_WORKER_POLL_MS=8000
# true = gửi GIẢ (không gọi Meta nhưng vẫn đánh "Đã gửi"). Đặt false để gửi thật.
SEND_DRY_RUN=true

# --- WhatsApp (Meta) ---
WHATSAPP_TOKEN_MAIN=
WHATSAPP_API_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_FORWARD_URL=
TRACKING_RELAY_SECRET=
AUTO_REPLY_COOLDOWN_MIN=
QUOTA_SAFETY_RATIO=
ACTIVITY_LOG_DAYS=

# --- Telegram ---
TELEGRAM_BOT_TOKEN_MAIN=
TELEGRAM_BOSS_CHAT_ID=

# --- Supabase Storage (ảnh template) ---
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Zalo OA ---
ZALO_APP_ID=
ZALO_SECRET_KEY=
ZALO_OA_ID=
ZALO_WEBHOOK_SECRET=
ZALO_OA_REFRESH_TOKEN=
ZALO_OA_TOKEN_MAIN=
ZALO_OAUTH_CALLBACK_URL=
ZALO_BOSS_USER_ID=
ZALO_TOKEN_SOURCE_DB_URL=
ZALO_WEBHOOK_FORWARD_URL=
